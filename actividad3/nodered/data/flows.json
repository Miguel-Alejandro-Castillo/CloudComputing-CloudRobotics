    {
        "id": "190309bd0718d407",
        "type": "ui-template",
        "z": "253bdab4982a9a38",
        "group": "27f9addadb448f94",
        "page": "",
        "ui": "",
        "name": "Estado del Sistema",
        "order": 0,
        "width": "9",
        "height": "1",
        "head": "",
        "format": "<template>\n    <div v-if=\"msg?.payload\" class=\"status\">\n\n        <div v-if=\"msg.payload.alarms.length === 0\" class=\"box normal\">\n            ✓ Funcionamiento normal\n        </div>\n\n        <div v-for=\"alarm in msg.payload.alarms\" :key=\"alarm\" class=\"box alarm\">\n            ⚠ {{ alarm }}\n        </div>\n\n    </div>\n</template>\n\n<style>\n    .status {\n        display: flex;\n        flex-direction: row;\n        flex-wrap: wrap;\n        gap: 0.5rem;\n        width: 100%;\n    }\n\n    .box {\n        padding: 10px 14px;\n        border-radius: 7px;\n        color: white;\n        font-weight: 600;\n        text-align: center;\n    }\n\n    .normal {\n        background: #43a047;\n    }\n\n    .alarm {\n        background: #e53935;\n    }\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 690,
        "y": 400,
        "wires": [
            []
        ]
    },
    {
        "id": "a63278e38f2f6131",
        "type": "function",
        "z": "253bdab4982a9a38",
        "name": "Evaluar Alarmas",
        "func": "const value = Number(msg.payload);\n\nif (msg.topic === \"sensor/turbidity\") {\n    flow.set(\"turbidity\", value);\n}\n\nif (msg.topic === \"sensor/waterPressure\") {\n    flow.set(\"waterPressure\", value);\n}\n\nconst turbidity = flow.get(\"turbidity\");\nconst waterPressure = flow.get(\"waterPressure\");\n\nconst alarms = [];\n\nif (turbidity !== undefined && turbidity >= 20) {\n    alarms.push(`Turbidez elevada: ${turbidity.toFixed(2)} NTU`);\n}\n\nif (waterPressure !== undefined && waterPressure >= 3) {\n    alarms.push(`Presión elevada: ${waterPressure.toFixed(2)} bar`);\n}\n\nmsg.payload = {\n    alarms: alarms\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 400,
        "wires": [
            [
                "190309bd0718d407"
            ]
        ]
    },
