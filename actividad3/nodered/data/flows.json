    {
        "id": "b928847f64d59069",
        "type": "function",
        "z": "253bdab4982a9a38",
        "name": "Umbrales e Histeresis",
        "func": "const level = Number(msg.payload);\nif (level <= 5) {\n    msg.payload = 1\n    return msg;\n}\n\nif (level >= 95) {\n    msg.payload = 0\n    return msg;\n}\n\nreturn null;\n\n\n\n",
